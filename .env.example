# Copiar para .env (ignorado pelo Git) e preencher com os dados FTP do alojamento Amen.pt.
FTP_HOST=
FTP_USER=
FTP_PASS=
# Porta FTP (normalmente 21)
FTP_PORT=21
# Opcional: pasta pública no servidor (se vazio, o script deteta public_html, httpdocs, www ou htdocs)
FTP_DIR=
# Opcional: "nao" se o certificado TLS do servidor FTP não corresponder ao nome (comum em alojamento partilhado)
FTP_VERIFICAR_CERTIFICADO=

# Formulário de pedido de informação (scripts/deploy.sh configurar-email): conta de email que envia os pedidos.
# Servidor de envio da Amen, por omissão smtp-pt.securemail.pro na porta 465 (confirmar no painel da Amen).
SMTP_USER=info@tantielorraine.pt
SMTP_PASS=
SMTP_HOST=smtp-pt.securemail.pro
SMTP_PORT=465
# Opcional: endereço do site, para testar o formulário (por omissão https://tantielorraine.pt)
SITE_URL=
